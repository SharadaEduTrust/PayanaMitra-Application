# ── Application ────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase ───────────────────────────────────────────────────
# Project settings → API. The anon key is public-safe because Row Level
# Security is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses RLS, so never expose this to the browser and
# never commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Document encryption ────────────────────────────────────────
# 32-byte key, base64 encoded. Used for AES-256-GCM encryption of
# guest document numbers. Generate once with:
#   openssl rand -base64 32
# Losing this key makes every stored document number unreadable.
ENCRYPTION_KEY=

# Pepper used by the backend when deriving PIN/password material.
# The Next.js app does not read this yet.
AUTH_PEPPER=

# ── Rate limiting ──────────────────────────────────────────────
ADMIN_RATE_LIMIT=20
