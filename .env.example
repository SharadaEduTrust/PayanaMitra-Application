# ─────────────────────────────────────────────────────────────
# Payana Mitra — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local
# ─────────────────────────────────────────────────────────────

# Supabase (public — safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# Supabase service-role key — SERVER ONLY, never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# Auth pepper — used to derive passwords via HMAC-SHA256
# Generate with: openssl rand -base64 32
AUTH_PEPPER=<random-32-byte-base64-string>

# Encryption key for PAN / passport numbers (AES-256-GCM)
# Must be exactly 32 bytes (256 bits), base64-encoded
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=<random-32-byte-base64-string>

# Web Push (VAPID) — required for POST /api/admin/push/send
# Generate a key pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=<base64url-encoded-ec-p256-public-key>
VAPID_PRIVATE_KEY=<base64url-encoded-ec-p256-private-key>
VAPID_SUBJECT=mailto:<your-admin-email>

# WhatsApp Cloud API (Meta Business Platform)
# Required for POST /api/admin/whatsapp/send
# and the optional sendWhatsapp flag on POST /api/admin/push/send
#
# Setup steps:
#   1. Create a Meta Business account → https://business.facebook.com
#   2. Add a WhatsApp Business app in the Developer portal → https://developers.facebook.com
#   3. Get your Phone Number ID from: App Dashboard → WhatsApp → Getting started
#   4. Generate a permanent system-user access token from Meta Business Settings
#
WHATSAPP_PHONE_NUMBER_ID=<numeric-phone-number-id>
WHATSAPP_ACCESS_TOKEN=<long-lived-system-user-access-token>

# iLoveAPI credentials for automatic PDF & Image compression (SERVER-ONLY, never prefix with NEXT_PUBLIC_)
# Get these keys from https://developer.ilovepdf.com / https://developer.iloveimg.com
ILOVEAPI_PUBLIC_KEY=
ILOVEAPI_SECRET_KEY=

# Optional image compression provider: 'iloveapi' (default) or 'sharp' (PDFs always use iloveapi)
IMAGE_COMPRESSION_PROVIDER=iloveapi

# Maximum admin file upload size in bytes (default: 26214400 = 25MB)
MAX_UPLOAD_FILE_SIZE_BYTES=26214400
